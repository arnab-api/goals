--- /dev/null
+++ b/src/q_transfer_alt/bank/render.py
@@ -0,0 +1,53 @@
+"""Model-free exact prompt components. Explicit written order is never re-sorted."""
+import random
+import hashlib
+from .task import digest
+
+RENDERER_VERSION = "1.0.0"
+PHRASES = {"int": "an integer", "str": "a string", "list[int]": "a list of integers", "list[str]": "a list of strings"}
+NAME_POOL = ("u", "v", "w", "t", "q", "r", "s", "j", "k", "m", "n", "h")
+
+
+def opaque_names(roles, seed):
+    names = list(NAME_POOL)
+    random.Random("diff-expanded-names-v1:" + str(seed)).shuffle(names)
+    keys = sorted(roles) + ["pending"]
+    if len(keys) > len(names):
+        raise ValueError("Opaque name pool exhausted")
+    return dict(zip(keys, names))
+
+
+def render_prompt(registry, roles, names, datatype, layout):
+    layout.validate()
+    if len(set(names.values())) != len(names) or "x" in names.values():
+        raise ValueError("Result names must be distinct from each other and input x")
+    if set(names) != set(roles) | {"pending"}:
+        raise ValueError("Names must cover all roles and pending")
+    if any(n not in NAME_POOL for n in names.values()):
+        raise ValueError("Names must be opaque members of NAME_POOL")
+    tasks = [registry.get(roles[r]) for r in layout.listed]
+    head = f"Write a Python program that implements a function `func` which, given {PHRASES[datatype]} `x`, computes:\n"
+    task_list = "\n".join(f"({i + 1}) {t.description}" for i, t in enumerate(tasks))
+    question = head + task_list + "\n"
+    signature = f"def func(x: {datatype}):"
+    assignments = [{"role": r, "task_id": roles[r], "variable": names[r],
+                    "text": f"    {names[r]} = {registry.get(roles[r]).expression}"} for r in layout.written]
+    pivot = f"    {names['pending']} ="
+    prefill = "\n".join(["<code>", signature] + [a["text"] for a in assignments] + [pivot])
+    text = question + prefill
+    descriptions = []
+    cursor = len(head)
+    for i, (r, t) in enumerate(zip(layout.listed, tasks)):
+        start = cursor + len(f"({i + 1}) ")
+        end = start + len(t.description)
+        descriptions.append({"role": r, "task_id": t.id, "start": start, "end": end, "text": t.description})
+        cursor = end + 1
+    record = {**layout.record(), "question": question, "prefill": prefill, "text": text,
+              "text_format": "question immediately followed by assistant code prefill; chat template deferred to runtime",
+              "task_list_text": task_list, "task_list_span": [len(head), len(head) + len(task_list)],
+              "span_unit": "Python Unicode code-point indices; end exclusive, relative to text",
+              "description_spans": descriptions, "supplied_assignments": assignments,
+              "unfinished_variable": names["pending"], "pivot": pivot,
+              "frontier_task_id": roles[layout.frontier], "text_sha256": hashlib.sha256(text.encode("utf-8")).hexdigest()}
+    record["components_sha256"] = digest(record)
+    return record
diff --git a/src/q_transfer_alt/bank/sampling.py b/src/q_transfer_alt/bank/sampling.py
new file mode 100644
index 0000000..114edd6e892193a90c37b7f398e3c36f4b732b29
--- /dev/null
+++ b/src/q_transfer_alt/bank/sampling.py
@@ -0,0 +1,88 @@
+"""Deterministic task selection with explicit, never-relaxed family policy."""
+from collections import Counter, defaultdict
+from math import factorial
+import random
+from .task import DOMAINS, digest
+
+
+class InfeasibleSampling(ValueError):
+    pass
+
+
+def pool_for(registry, datatype, candidate_ids=None):
+    if datatype not in DOMAINS:
+        raise ValueError(f"Unknown datatype: {datatype}")
+    if candidate_ids is None:
+        return [t for t in registry.tasks if t.datatype == datatype]
+    if len(set(candidate_ids)) != len(candidate_ids):
+        raise ValueError("Duplicate candidate IDs")
+    tasks = [registry.get(i) for i in candidate_ids]
+    if any(t.datatype != datatype for t in tasks):
+        raise ValueError("Candidate datatype mismatch")
+    return sorted(tasks, key=lambda t: t.id)
+
+
+def assignment_space(pool, role_count, family_policy):
+    if family_policy not in ("distinct", "any"):
+        raise ValueError(f"Unknown family policy: {family_policy}")
+    if any(t.incompatible_ids for t in pool):
+        raise ValueError("Exact assignment counting supports only the shipped bank's family/ID policy; pair exclusions require a new counter")
+    if role_count < 1:
+        raise ValueError("role_count must be positive")
+    counts = Counter(t.family for t in pool)
+    if family_policy == "any":
+        n = len(pool)
+        count = factorial(n) // factorial(n - role_count) if n >= role_count else 0
+        family_combinations = None
+    else:
+        dp, cp = [1] + [0] * role_count, [1] + [0] * role_count
+        for n in counts.values():
+            for k in range(role_count, 0, -1):
+                dp[k] += n * dp[k - 1]
+                cp[k] += cp[k - 1]
+        count = factorial(role_count) * dp[role_count]
+        family_combinations = cp[role_count]
+    return {"role_count": role_count, "candidate_tasks": len(pool),
+            "family_policy": family_policy, "family_counts": dict(sorted(counts.items())),
+            "feasible_ordered_role_assignments": count,
+            "feasible_unordered_family_sets": family_combinations,
+            "count_method": "exact combinatorial count; task IDs distinct",
+            "policy_note": "Family labels are a sampling policy, not mathematical independence."}
+
+
+def validate_roles(registry, roles, required, datatype, family_policy):
+    if family_policy not in ("distinct", "any"):
+        raise ValueError(f"Unknown family policy: {family_policy}")
+    if set(roles) != set(required):
+        raise ValueError(f"Role keys must be exactly {list(required)}")
+    tasks = [registry.get(roles[r]) for r in required]
+    if any(t.datatype != datatype for t in tasks):
+        raise ValueError("Role datatype mismatch")
+    for i, a in enumerate(tasks):
+        for b in tasks[i + 1:]:
+            if not registry.compatible(a.id, b.id, family_policy):
+                raise InfeasibleSampling(f"Incompatible roles: {a.id}, {b.id}; policy={family_policy}")
+
+
+def sample_roles(registry, scenario, datatype, seed, family_policy="distinct", candidate_ids=None):
+    pool = pool_for(registry, datatype, candidate_ids)
+    space = assignment_space(pool, len(scenario.roles), family_policy)
+    if space["feasible_ordered_role_assignments"] == 0:
+        raise InfeasibleSampling(f"No feasible {len(scenario.roles)}-role assignment: {space}")
+    rng = random.Random(seed)
+    if family_policy == "any":
+        chosen = rng.sample(pool, len(scenario.roles))
+        method = "uniform task sampling without replacement using Python Random"
+    else:
+        groups = defaultdict(list)
+        for t in pool:
+            groups[t.family].append(t)
+        families = rng.sample(sorted(groups), len(scenario.roles))
+        chosen = [rng.choice(groups[f]) for f in families]
+        method = "uniform distinct family sequence, then uniform task within family; NOT uniform over task assignments"
+    roles = dict(zip(scenario.roles, (t.id for t in chosen)))
+    validate_roles(registry, roles, scenario.roles, datatype, family_policy)
+    ids = sorted(t.id for t in pool)
+    return roles, {**space, "sampling_method": method, "rejections": [],
+                   "candidate_ids": ids, "candidate_ids_sha256": digest(ids),
+                   "excluded_by_datatype": len(registry.tasks) - sum(t.datatype == datatype for t in registry.tasks)}
diff --git a/src/q_transfer_alt/bank/scenarios.py b/src/q_transfer_alt/bank/scenarios.py
new file mode 100644
index 0000000..2310ae982ce6c11356053a952bf1d8a386fdc71a
--- /dev/null
+++ b/src/q_transfer_alt/bank/scenarios.py
@@ -0,0 +1,83 @@
+"""Frozen layouts. Selectors identify tasks, not their numerical execution results."""
+from dataclasses import dataclass
+from .task import digest
+
+SCENARIO_VERSION = "1.0.0"
+
+
+@dataclass(frozen=True)
+class Layout:
+    listed: tuple
+    written: tuple
+
+    def validate(self):
+        if len(self.listed) != 4 or len(set(self.listed)) != 4:
+            raise ValueError("Exactly four distinct listed roles required")
+        if len(set(self.written)) != len(self.written) or not set(self.written) < set(self.listed):
+            raise ValueError("Written roles must be a distinct proper subset of listed roles")
+        return self
+
+    @property
+    def frontier(self):
+        return first_absent(self.listed, self.written)
+
+    def record(self):
+        self.validate()
+        return {"listed_roles": list(self.listed), "written_roles": list(self.written),
+                "completed_set": sorted(self.written), "frontier_role": self.frontier}
+
+
+def first_absent(ordered, completed):
+    return next((r for r in ordered if r not in set(completed)), None)
+
+
+@dataclass(frozen=True)
+class Scenario:
+    id: str
+    src: Layout
+    dst: Layout
+    kv: Layout = None
+
+    @property
+    def roles(self):
+        return tuple(sorted(set(self.src.listed + self.dst.listed + (() if self.kv is None else self.kv.listed))))
+
+    @property
+    def predictions(self):
+        target_list = self.kv.listed if self.kv else self.dst.listed
+        p = {"source_copy": self.src.frontier, "clean_destination": self.dst.frontier,
+             "set_transferred_list" if self.kv else "set": first_absent(target_list, self.src.written),
+             "count_transferred_list" if self.kv else "count": target_list[len(self.src.written)],
+             "order_id": target_list[self.src.listed.index(self.src.frontier)],
+             "last_written_successor": target_list[target_list.index(self.src.written[-1]) + 1]}
+        if self.kv:
+            p.update(kv_only=self.kv.frontier, count_original_destination=self.dst.listed[len(self.src.written)])
+        return p
+
+    def record(self):
+        result = {"id": self.id, "version": SCENARIO_VERSION,
+                  "layouts": {"p_src": self.src.record(), "p_dst": self.dst.record()},
+                  "symbolic_predictions": self.predictions,
+                  "set_rule": "first listed task absent from source completed set",
+                  "order_id_rule": "source frontier's zero-based list index applied to recipient list",
+                  "count_rule": "source completed count as zero-based index in named list",
+                  "last_written_rule": "successor of final written source role in recipient list"}
+        if self.kv:
+            result["layouts"]["p_kv"] = self.kv.record()
+        result["definition_sha256"] = digest(result)
+        return result
+
+
+SCENARIOS = {
+    "ALT1": Scenario("ALT1", Layout(tuple("abcd"), tuple("abd")), Layout(tuple("abde"), tuple("a"))),
+    "ALT2": Scenario("ALT2", Layout(tuple("abcd"), tuple("abd")), Layout(tuple("adef"), tuple("a"))),
+    "ALT3": Scenario("ALT3", Layout(tuple("abcd"), tuple("abc")), Layout(tuple("acbe"), tuple("a"))),
+    "ALT2_KV": Scenario("ALT2_KV", Layout(tuple("abcd"), tuple("abd")), Layout(tuple("axyz"), tuple("a")), Layout(tuple("adef"), tuple("a"))),
+}
+
+
+def get_scenario(name):
+    try:
+        return SCENARIOS[name]
+    except KeyError:
+        raise ValueError(f"Unknown scenario: {name}") from None
diff --git a/src/q_transfer_alt/bank/task.py b/src/q_transfer_alt/bank/task.py
new file mode 100644
index 0000000..1c8a03a45f63cdfeae323714f99b6af4e2e38942
--- /dev/null
+++ b/src/q_transfer_alt/bank/task.py
@@ -0,0 +1,83 @@
+"""Standard-library-only task definitions; independent of the legacy bank."""
+from dataclasses import dataclass
+import hashlib
+import inspect
+import json
+from typing import Callable, Any
+
+BANK_VERSION = "1.0.0"
+DOMAIN_VERSION = "1.0.0"
+DOMAINS = {
+    "int": {"kind": "int", "minimum": -1000000, "maximum": 1000000, "exclude_bool": True},
+    "str": {"kind": "str", "max_length": 128, "alphabet": "Unicode code points"},
+    "list[int]": {"kind": "list[int]", "max_length": 32, "element_minimum": -1000000, "element_maximum": 1000000, "exclude_bool": True},
+    "list[str]": {"kind": "list[str]", "max_length": 32, "element_max_length": 32, "alphabet": "Unicode code points"},
+}
+
+
+def canonical(value):
+    return json.dumps(value, sort_keys=True, ensure_ascii=True, separators=(",", ":"))
+
+
+def digest(value):
+    return hashlib.sha256(canonical(value).encode("utf-8")).hexdigest()
+
+
+def typed(value):
+    """Keep bool/int and container identities distinct in signatures."""
+    if type(value) is list:
+        return {"type": "list", "value": [typed(v) for v in value]}
+    if type(value) not in (int, bool, str):
+        raise TypeError(f"Unsupported output type: {type(value).__name__}")
+    return {"type": type(value).__name__, "value": value}
+
+
+def in_domain(datatype, value):
+    if datatype == "int":
+        return type(value) is int and -1000000 <= value <= 1000000
+    if datatype == "str":
+        return type(value) is str and len(value) <= 128
+    if datatype == "list[int]":
+        return type(value) is list and len(value) <= 32 and all(in_domain("int", v) for v in value)
+    if datatype == "list[str]":
+        return type(value) is list and len(value) <= 32 and all(type(v) is str and len(v) <= 32 for v in value)
+    raise ValueError(f"Unknown datatype: {datatype}")
+
+
+def output_matches(output_type, value):
+    if output_type in ("int", "bool", "str"):
+        return type(value).__name__ == output_type
+    if output_type in ("list[int]", "list[str]"):
+        element = output_type[5:-1]
+        return type(value) is list and all(type(v).__name__ == element for v in value)
+    return False
+
+
+@dataclass(frozen=True)
+class Task:
+    id: str
+    datatype: str
+    description: str
+    output_type: str
+    family: str
+    expression: str
+    reference: Callable[[Any], Any]
+    incompatible_ids: tuple = ()
+    compatibility_note: str = "Distinct IDs and finite-suite signatures required; optional distinct-family policy."
+
+    def evaluate(self, value):
+        if not in_domain(self.datatype, value):
+            raise ValueError(f"Input outside {self.datatype} domain for {self.id}")
+        # Expressions are trusted shipped code, NOT a sandbox for external strings.
+        return eval(self.expression, {"x": value})
+
+    def record(self):
+        record = {"id": self.id, "datatype": self.datatype, "description": self.description,
+                  "output_type": self.output_type, "family": self.family,
+                  "expression": self.expression, "assignment": "{name} = " + self.expression,
+                  "input_domain": DOMAINS[self.datatype], "domain_version": DOMAIN_VERSION,
+                  "compatibility": {"incompatible_ids": list(self.incompatible_ids), "note": self.compatibility_note},
+                  "reference_name": self.reference.__name__,
+                  "reference_source": inspect.getsource(self.reference)}
+        record["definition_sha256"] = digest(record)
+        return record
diff --git a/src/q_transfer_alt/interventions.py b/src/q_transfer_alt/interventions.py
new file mode 100644
index 0000000..f4a35e3f414b7df90872417277f3312978f41bab
--- /dev/null
+++ b/src/q_transfer_alt/interventions.py
@@ -0,0 +1,240 @@
+"""Standalone, inference-only Qwen2 projection and headwise KV transfers.
+
+Adapted from the customer-owned ``vendor/functional_original.py``. Requires
+HF Qwen2 eager attention, ``model.model.layers`` and ``model.model.rotary_emb``.
+The caller owns eval mode and gradient/inference mode (capture uses no_grad).
+KV spans assume unpadded, zero-based absolute positions and a full-context cache;
+sliding-window caches, custom position IDs and concurrent use are unsupported.
+"""
+
+from collections import defaultdict
+from contextlib import contextmanager
+import importlib
+from operator import index
+import types
+
+import torch
+
+__all__ = ["capture", "query_patch", "kv_patch"]
+
+
+def _attention(model, layer):
+    if not 0 <= layer < len(model.model.layers):
+        raise ValueError(f"Invalid layer {layer}")
+    return model.model.layers[layer].self_attn
+
+
+def _headmap(model, heads):
+    grouped = defaultdict(set)
+    for layer, head in heads:
+        layer, head = index(layer), index(head)
+        attn = _attention(model, layer)
+        if not 0 <= head < attn.q_proj.out_features // attn.head_dim:
+            raise ValueError(f"Invalid query head {(layer, head)}")
+        grouped[layer].add(head)
+    return {layer: sorted(hs) for layer, hs in grouped.items()}
+
+
+def _positions(positions):
+    result = tuple(index(p) for p in positions)
+    if len(set(result)) != len(result):
+        raise ValueError("Positions must be unique")
+    return result
+
+
+def _local_positions(positions, length):
+    return [(row, p if p >= 0 else length + p)
+            for row, p in enumerate(positions) if -length <= p < length]
+
+
+def _check_cache(cache, layer, rows, width):
+    if layer not in cache or tuple(cache[layer].shape) != (rows, width):
+        raise ValueError(f"Cache layer {layer} must have shape {(rows, width)}")
+
+
+def capture(model, inputs, layers, positions, which):
+    """Capture raw q/k/v projection rows, before RoPE, as detached CPU float32.
+
+    Inputs are model keyword arguments for a single example; positions index
+    the current input sequence. Unlike patch hooks, absent positions are errors.
+    No generation cache is created or consumed by this helper.
+    """
+    if which not in ("q", "k", "v"):
+        raise ValueError("which must be 'q', 'k' or 'v'")
+    positions = _positions(positions)
+    layers = sorted(set(index(layer) for layer in layers))
+    if inputs.get("past_key_values") is not None:
+        raise ValueError("capture expects a full input, without past_key_values")
+    result, handles = {}, []
+    try:
+        for layer in layers:
+            projection = getattr(_attention(model, layer), f"{which}_proj")
+
+            def hook(module, args, output, layer=layer):
+                if output.shape[0] != 1:
+                    raise ValueError("capture requires batch size one")
+                kept = _local_positions(positions, output.shape[1])
+                if len(kept) != len(positions):
+                    raise ValueError("Capture position outside input sequence")
+                result[layer] = output[0, [p for _, p in kept]].detach().float().cpu().clone()
+
+            handles.append(projection.register_forward_hook(hook))
+        with torch.no_grad():
+            model(**{**inputs, "use_cache": False})
+    finally:
+        for handle in handles:
+            handle.remove()
+    return result
+
+
+@contextmanager
+def query_patch(model, cache, heads, positions=(-1,)):
+    """Replace selected query-head slices at raw q_proj output, before RoPE.
+
+    Cache row r maps to positions[r] on each forward; absent positive positions
+    are skipped on decode. Default -1 patches the final token on every forward.
+    Donor rows broadcast across recipient batch examples.
+    """
+    positions = _positions(positions)
+    headmap = _headmap(model, heads)
+    handles = []
+    try:
+        for layer, hs in headmap.items():
+            attn = _attention(model, layer)
+            _check_cache(cache, layer, len(positions), attn.q_proj.out_features)
+
+            def hook(module, args, output, hs=hs, hd=attn.head_dim, source=cache[layer]):
+                kept = _local_positions(positions, output.shape[1])
+                if not kept:
+                    return output
+                patched = output.clone()
+                donor = source.to(device=output.device, dtype=output.dtype)
+                for head in hs:
+                    sl = slice(head * hd, (head + 1) * hd)
+                    for row, pos in kept:
+                        patched[:, pos, sl] = donor[row, sl]
+                return patched
+
+            handles.append(attn.q_proj.register_forward_hook(hook))
+        yield
+    finally:
+        for handle in handles:
+            handle.remove()
+
+
+def _headwise_forward(attn, state):
+    native = importlib.import_module(type(attn).__module__)
+
+    def forward(self, hidden_states, position_embeddings, attention_mask,
+                past_key_values=None, **kwargs):
+        if self.training:
+            raise ValueError("kv_patch requires model.eval()")
+        shape = hidden_states.shape[:-1]
+        head_shape = (*shape, -1, self.head_dim)
+        # Call the modules, not F.linear: query_patch and observation hooks must fire.
+        q = self.q_proj(hidden_states).view(head_shape).transpose(1, 2)
+        k = self.k_proj(hidden_states).view(head_shape).transpose(1, 2)
+        v = self.v_proj(hidden_states).view(head_shape).transpose(1, 2)
+        q, k = native.apply_rotary_pos_emb(q, k, *position_embeddings)
+        if past_key_values is not None:
+            # HF 5.18: update accepts exactly these three arguments. Never write
+            # donor KV to cache: the cache stores the actual recipient trajectory.
+            k, v = past_key_values.update(k, v, self.layer_idx)
+        options = dict(kwargs)
+        options.update(dropout=0.0, scaling=self.scaling,
+                       sliding_window=getattr(self, "sliding_window", None))
+        clean, clean_weights = native.eager_attention_forward(self, q, k, v, attention_mask, **options)
+        del clean_weights
+        span = state["span"]
+        if span and max(span) >= k.shape[-2]:
+            raise ValueError("KV destination span must already exist in the prefix")
+        k2, v2 = k.clone(), v.clone()
+        layer = self.layer_idx
+        for kvhead, donor in state["src_k"][layer].items():
+            k2[:, kvhead, span, :] = donor.to(device=k.device, dtype=k.dtype)
+            v2[:, kvhead, span, :] = state["src_v"][layer][kvhead].to(device=v.device, dtype=v.dtype)
+        transferred, transferred_weights = native.eager_attention_forward(self, q, k2, v2, attention_mask, **options)
+        routed = clean.clone()
+        hs = state["goal_qheads"][layer]
+        routed[:, :, hs, :] = transferred[:, :, hs, :]
+        state["forward_calls"][layer] += 1
+        if state.get("observer") is not None:
+            other_positions = [j for j in range(k.shape[-2]) if j not in span]
+            expected_heads = sorted({h // self.num_key_value_groups for h in hs})
+            assert sorted(state["src_k"][layer]) == expected_heads
+            checks = {
+                "nonspan_k_max_abs": float((k2[:, :, other_positions] - k[:, :, other_positions]).abs().max()),
+                "nonspan_v_max_abs": float((v2[:, :, other_positions] - v[:, :, other_positions]).abs().max()),
+                "donor_k_max_abs": max(float((k2[0,h,span] - state["src_k"][layer][h]).abs().max()) for h in expected_heads),
+                "donor_v_max_abs": max(float((v2[0,h,span] - state["src_v"][layer][h]).abs().max()) for h in expected_heads),
+            }
+            assert max(checks.values()) == 0
+            state["kv_checks"][layer] = checks
+            state["observer"](self, transferred_weights, v2, transferred, clean, routed)
+        # Do not return clean attention weights for patched head outputs.
+        return self.o_proj(routed.reshape(*shape, -1).contiguous()), None
+
+    return forward
+
+
+@contextmanager
+def kv_patch(model, heads, k_cache, v_cache, dest_positions, observer=None):
+    """Route donor KV to only the chosen QUERY heads, without GQA sibling bleed.
+
+    k_cache/v_cache contain raw k_proj/v_proj rows from capture. Keys are rotated
+    at fixed destination positions, values are not rotated. Routing is reapplied
+    on every prefill/decode forward while this context is active. The native
+    cache always holds untransplanted KV of the *intervened trajectory*, not an
+    independent baseline run. Attention weights are intentionally omitted.
+
+    Optional observer receives effective attention, values and routing outputs without modifying them.
+
+    Yields state with span, goal_qheads, src_k/src_v (rotated per KV head), and
+    per-layer forward_calls. Does not retain full attention matrices/activations.
+    """
+    headmap = _headmap(model, heads)
+    span = list(_positions(dest_positions))
+    if any(p < 0 for p in span):
+        raise ValueError("KV destinations must be nonnegative absolute positions")
+    state = {"observer": observer, "kv_checks": {}, "span": span, "goal_qheads": headmap, "src_k": {}, "src_v": {},
+             "forward_calls": {layer: 0 for layer in headmap}}
+    if not headmap or not span:
+        yield state
+        return
+    originals = []
+    try:
+        for layer, hs in headmap.items():
+            attn = _attention(model, layer)
+            if getattr(attn, "sliding_window", None) is not None:
+                raise ValueError("kv_patch supports full-context attention only")
+            hd = attn.head_dim
+            nq, nkv = attn.q_proj.out_features // hd, attn.k_proj.out_features // hd
+            if nq % nkv:
+                raise ValueError("Query head count must be divisible by KV head count")
+            _check_cache(k_cache, layer, len(span), attn.k_proj.out_features)
+            _check_cache(v_cache, layer, len(span), attn.v_proj.out_features)
+            native = importlib.import_module(type(attn).__module__)
+            ref = attn.q_proj.weight
+            pos = torch.tensor([span], device=ref.device, dtype=torch.long)
+            dummy = ref.new_zeros(1, len(span), hd)
+            with torch.no_grad():
+                cos, sin = model.model.rotary_emb(dummy, pos)
+                cos, sin = cos.to(ref.device), sin.to(ref.device)
+                keys, values = {}, {}
+                for kvhead in sorted({h // (nq // nkv) for h in hs}):
+                    sl = slice(kvhead * hd, (kvhead + 1) * hd)
+                    raw = k_cache[layer][:, sl].to(ref.device, ref.dtype)[None, None]
+                    _, rotated = native.apply_rotary_pos_emb(torch.zeros_like(raw), raw, cos, sin)
+                    keys[kvhead] = rotated[0, 0].detach()
+                    values[kvhead] = v_cache[layer][:, sl].to(ref.device, ref.dtype).detach().clone()
+            state["src_k"][layer], state["src_v"][layer] = keys, values
+            # Preserve instance-level overrides as well as ordinary class methods.
+            originals.append((attn, attn.__dict__.get("forward"), "forward" in attn.__dict__))
+            attn.forward = types.MethodType(_headwise_forward(attn, state), attn)
+        yield state
+    finally:
+        for attn, original, had_override in reversed(originals):
+            if had_override:
+                attn.forward = original
+            else:
+                del attn.forward
