+    def test_bootstrap_reuses_whole_group_indices_and_paired_difference(self):
+        values = np.array([1., 2., 7.])
+        indices = analysis.bootstrap_indices({'str': ['a', 'b', 'c']}, draws=200, seed=82391)['str']
+        again = analysis.bootstrap_indices({'str': ['a', 'b', 'c']}, draws=200, seed=82391)['str']
+        assert np.array_equal(indices, again)
+        expected = np.quantile(values[indices].mean(axis=1), [.025, .975])
+        got = analysis.estimate(values, indices)
+        np.testing.assert_array_equal([got['ci_low'], got['ci_high']], expected)
+        # A constant paired shift has a point interval despite variable marginal means.
+        shifted = analysis.estimate((values + .5) - values, indices)
+        assert shifted == {'value': .5, 'ci_low': .5, 'ci_high': .5}
+        counted = analysis.estimate([True, False, True], indices, count=True)
+        assert counted['value'] == 2
