@@ -0,0 +1,227 @@
+"""Portable frozen alternate-hypothesis grid; full-prefill forwards, no decoding.
+
+Import, --help and --dry-run use only the standard library. Real execution is
+restricted to the historical Python 3.11 / Transformers 5.18.0 GPU runtime.
+"""
+import argparse
+import contextlib
+import importlib.metadata
+import json
+import pathlib
+import platform
+import time
+
+from . import CONFIG_DIR
+from .loader import load_panel
+from .validate_panel import validate_panel
+from .provenance import (PINNED_REVISION, dump, file_sha, sha, recipe_hash,
+                         verify_model_manifest, verify_resume, prepare_resume, source_cache_key)
+
+ALT_ROLE = {'ALT1': 'd', 'ALT2': 'f', 'ALT3': 'b'}
+SETTINGS = {'seed': 0, 'batch_size': 1, 'dtype': 'bfloat16', 'attention': 'eager',
+            'alpha': 1, 'ov_boost': False, 'generated_tokens': 0,
+            'q_position': 'final equals only; pre-RoPE', 'use_cache': False}
+
+
+def runtime_versions():
+    """Enforce supported numerical stack and bind actual dependencies to resume."""
+    if platform.python_version_tuple()[:2] != ('3', '11'):
+        raise RuntimeError('Full-model runtime requires historical Python 3.11')
+    versions = {name: importlib.metadata.version(name) for name in
+                ('torch', 'transformers', 'numpy', 'tokenizers', 'huggingface-hub', 'safetensors')}
+    for name, expected in {'torch': '2.11.0+cu128', 'transformers': '5.18.0', 'numpy': '2.4.6'}.items():
+        if versions[name] != expected:
+            raise RuntimeError(f'Full-model runtime requires {name}=={expected}; found {versions[name]}')
+    return {'python': platform.python_version(), 'versions': versions}
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('--panel', type=pathlib.Path, required=True)
+    ap.add_argument('--model-path', type=pathlib.Path)
+    ap.add_argument('--model-manifest', type=pathlib.Path)
+    ap.add_argument('--output', type=pathlib.Path, required=True)
+    ap.add_argument('--resume', type=pathlib.Path)
+    ap.add_argument('--pilot', action='store_true')
+    ap.add_argument('--dry-run', action='store_true')
+    args = ap.parse_args(argv)
+    panel = load_panel(args.panel)
+    validation = validate_panel(panel)
+    heads = [tuple(h) for h in panel['goal_heads']]
+    reference_heads = json.loads((CONFIG_DIR / 'goal250.json').read_text())
+    if heads != [tuple(h) for h in reference_heads] or len(heads) != 250:
+        raise ValueError('Runtime requires the exact ordered 250 goal heads')
+    if len(panel['rows']) != 384 or len(panel['groups']) != 128:
+        raise ValueError('Runtime requires the validated 384-row, 128-group grid')
+    selected = [g for g in panel['groups'] if not args.pilot or g['index'] == 0]
+    grouped = {g['id']: [r for r in panel['rows'] if r['group_id'] == g['id']]
+               for g in panel['groups']}
+    panel_sha = file_sha(args.panel)
+    if args.dry_run:
+        dump(args.output / 'dry_run.json', {
+            'schema': 'q_transfer_alt_dry_run_v1', 'groups': len(selected),
+            'rows': sum(len(grouped[g['id']]) for g in selected),
+            'primary_conditions': 2 * sum(len(grouped[g['id']]) for g in selected),
+            'heads': len(heads), 'settings': SETTINGS, 'panel_sha256': panel_sha,
+            'validated_panel_rows': len(panel['rows']), 'pilot': args.pilot,
+            'tokenization_performed': False, 'inference_performed': False,
+            'note': 'Schema validation only; no tokenization, model loading or inference.',
+            'panel_validation': validation})
+        return 0
+    if args.model_path is None or args.model_manifest is None:
+        ap.error('inference requires --model-path and --model-manifest')
+    fingerprint = runtime_versions()
+    identity = verify_model_manifest(args.model_path, args.model_manifest)
+    options = dict(SETTINGS, pilot=args.pilot, runtime=fingerprint)
+    recipe = recipe_hash(args.panel, heads, identity, options)
+    # No model or tokenizer loading, and no artifact copying, precedes resume validation.
+    prepare_resume(args.output, args.resume, selected, grouped, recipe, panel_sha)
+    return _execute(args, panel, validation, heads, selected, grouped, panel_sha, identity, recipe)
+
+
+def _execute(args, panel, validation, heads, selected, grouped, panel_sha, identity, recipe):
+    import torch
+    with torch.inference_mode():
+        return _run(args, panel, validation, heads, selected, grouped, panel_sha, identity, recipe)
+
+
+def _run(args, panel, validation, heads, selected, grouped, panel_sha, identity, recipe):
+    import numpy as np
+    import torch
+    from transformers import AutoModelForCausalLM, AutoTokenizer
+    from .interventions import query_patch, kv_patch
+    from .observe import Gaze, native_gaze
+    from .prompts import materialize_group
+    from .runtime_helpers import projections, audited_query, rotation_audit, arrays
+    torch.set_num_threads(1)
+    torch.manual_seed(0)
+    np.random.seed(0)
+    torch.set_float32_matmul_precision('highest')
+    if torch.cuda.device_count() != 1:
+        raise RuntimeError('Runtime requires exactly one visible CUDA device')
+    out = args.output
+    out.mkdir(parents=True, exist_ok=True)
+    dump(out / 'panel_validation.json', validation)
