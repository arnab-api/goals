+                gaze.validate();p=arrays(gaze,sub/f'{alt}_source.npz')
+                src=summarize(p,ps['p_src']['description_positions'],f'groups/{gid}/{alt}_source.npz',sha(ps['p_src']['input_ids']))
+                source_cache[qkey]=(stores['q'],src);check['sources'][qkey]=gaze.checks
+            else:check['cache_reuse'].append({'scenario':alt,'source_key':qkey,'same_exact_ids':True})
+            q,source_record=source_cache[qkey]
+            with projections(model,{'k':('k',layers,mat['donor_positions']),'v':('v',layers,mat['donor_positions'])}) as kv:forward(ps['p_kv'])
+            mapping=dict(mat['donor_to_dst'])
+            transferred={r:[mapping[j] for j in ix] for r,ix in ps['p_kv']['description_positions'].items()}
+            record={k:row[k] for k in ['id','group_id','scenario','datatype','seed','roles','predictions']}
+            record.update(config_sha256=sha(row),panel_sha256=panel_sha,recipe_sha256=recipe,source_cache_key=qkey,
+                prompt_hashes={k:sha(p['input_ids']) for k,p in ps.items()},materialized=f'groups/{gid}/materialized.json',
+                conditions={'clean_source':source_record,'clean_destination':clean_record})
+            rc={};logits={}
+            for name,use_q in [('kv_only',False),('kv_plus_source_q',True)]:
+                gaze=Gaze(heads)
+                with kv_patch(model,heads,kv['k'],kv['v'],mat['destination_positions'],observer=gaze.transferred) as state:
