+            self.assertTrue(all(in_domain(datatype, case) for case in cases))
+            self.assertIn([], cases)
+            self.assertEqual(max(map(len, cases)), 32)
+        self.assertTrue(any(-1000000 in case and 1000000 in case for case in CASES['list[int]']))
+        self.assertTrue(any('é' in case and 'e\u0301' in case for case in CASES['list[str]']))
+
+    def test_reference_matching_types_and_no_mutation(self):
+        for task in TASKS:
+            for index, case in enumerate(CASES[task.datatype]):
+                with self.subTest(task=task.id, case=index):
