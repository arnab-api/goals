+    def test_exact_ties_and_triplets(self):
+        records = small_records()[:3]
+        assert analysis.winner_key(['e', 'd']) == '{d|e}'
+        assert analysis.triplet_key(records, analysis.PRIMARY[0]) == 'eee'
+        assert analysis.triplet_key(records, analysis.PRIMARY[1]) == '{d|e}/e/e'
+        # No approximate tie threshold exists in the raw validator or exporter.
+        raw = {'head_ids': np.array([[0, 0]]), 'attention': np.ones((1, 4), np.float32) / 4,
+               'value_norm': np.ones((1, 4), np.float32), 'head_output': np.zeros((1, 2), np.float32)}
+        c = condition(dict(zip('abde', [.25] * 4)))
+        c['winners'] = ['e']
+        with self.assertRaisesRegex(ValueError, 'winner'):
+            analysis.raw_diagnostic(raw, c, [(0, 0)])
+
+
+    def test_raw_reaggregation_every_mean_and_sum(self):
+        a = np.array([[.125, .25, .125, .5], [.25, .125, .125, .5]], dtype=np.float32)
+        v = np.array([[2, 4, 2, 1], [4, 2, 2, 1]], dtype=np.float32)
+        positions = {'a': [0, 1], 'e': [2, 3]}
+        product = a * v
+        c = condition({r: float(product[:, ix].mean()) for r, ix in positions.items()}, positions=positions)
+        raw = {'attention': a, 'value_norm': v, 'head_ids': np.array([[0, 1], [1, 2]]),
+               'head_output': np.ones((2, 3), dtype=np.float32)}
+        result = analysis.raw_diagnostic(raw, c, [(0, 1), (1, 2)])
+        assert result['max_abs_score_or_sum_error'] == 0
+        assert result['float64_sums']['a'] == 1.25
+        for field in ('scores', 'sums'):
+            broken = deepcopy(c)
+            broken[field]['e'] += 2e-6
+            with self.assertRaisesRegex(ValueError, 'differs'):
+                analysis.raw_diagnostic(raw, broken, [(0, 1), (1, 2)])
+        for field, value in [('head_ids', raw['head_ids'][::-1]), ('attention', a[:, :3]),
+                             ('value_norm', np.full_like(v, np.nan))]:
+            with self.assertRaises(ValueError):
+                analysis.raw_diagnostic({**raw, field: value}, c, [(0, 1), (1, 2)])
+
