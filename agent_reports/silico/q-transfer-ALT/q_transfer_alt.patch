+                rec['set_minus_alternative']=rec['scores']['e']-rec['scores'][ALT_ROLE[alt]]
+                record['conditions'][name]=rec;rc[name+'_gaze']=gaze.checks;logits[name]=z
+            rc['query_logit_delta_max_abs']=float((logits['kv_plus_source_q']-logits['kv_only']).abs().max())
+            if controls:
+                with kv_patch(model,heads,kv['k'],kv['v'],mat['destination_positions']),query_patch(model,q,heads,positions=(-1,)): plain=forward(dst)
+                rc['kv_capture_logit_max_abs']=float((plain-logits['kv_plus_source_q']).abs().max());assert rc['kv_capture_logit_max_abs']==0
+                np.savez_compressed(sub/f'{alt}_logit_controls.npz',clean=clean_logits.numpy(),kv_only=logits['kv_only'].numpy(),kv_plus_query=logits['kv_plus_source_q'].numpy(),capture_off=plain.numpy())
+            record['paired_margin_change']=record['conditions']['kv_plus_source_q']['set_minus_alternative']-record['conditions']['kv_only']['set_minus_alternative']
+            group_records.append(record);check['rows'][alt]=rc
+        assert len(source_cache)==2 and len(check['cache_reuse'])==1 and check['cache_reuse'][0]['scenario']=='ALT2'
+        assert [b.self_attn.forward for b in model.model.layers]==native
+        torch.cuda.synchronize();stats={'schema':'q_transfer_alt_group_v1','group_id':gid,'panel_sha256':panel_sha,'group_sha256':sha(group),'seconds':time.monotonic()-t,
+            'forwards':forward_count-f0,'peak_gpu_allocated_bytes':torch.cuda.max_memory_allocated(),'peak_gpu_reserved_bytes':torch.cuda.max_memory_reserved(),'records':3}
+        dump(sub/'scores.json',group_records);dump(sub/'checks.json',check)
+        stats['recipe_sha256']=recipe
+        stats['file_sha256']={p.name:file_sha(p) for p in sorted(sub.iterdir()) if p.is_file() and p.name!='complete.json'}
+        dump(sub/'complete.json',stats)
+        records.extend(group_records);completed+=1
+        print('GROUP',completed,'/',len(selected),json.dumps(stats),'WINNERS',[(r['scenario'],r['conditions']['kv_only']['winners'],r['conditions']['kv_plus_source_q']['winners']) for r in group_records],flush=True)
+    dump(out/'scores.json',records)
+    dump(out/'run_summary.json',{'completed_groups':completed,'completed_configurations':len(records),'primary_observations':2*len(records),
+         'forwards_this_job':forward_count,'generated_tokens':0,'load_seconds':loaded-start,'run_seconds':time.monotonic()-loaded,
+         'load_and_run_seconds':time.monotonic()-start,'pilot':args.pilot,'all_checks_passed':True,
+         'peak_gpu_allocated_bytes':torch.cuda.max_memory_allocated(),'peak_gpu_reserved_bytes':torch.cuda.max_memory_reserved()})
+    print('FINISHED',len(records),'configurations',flush=True)
+
+
+def summarize(p,positions,raw,prompt_hash):
+    from .runtime_helpers import winner
+    product=p['attention'].float()*p['value_norm'].float()
+    s={r:float(product[:,ix].mean()) for r,ix in positions.items()}
+    return {'scores':s,'sums':{r:float(product[:,ix].mean(0).sum()) for r,ix in positions.items()},
+            'description_token_counts':{r:len(ix) for r,ix in positions.items()},
+            'winners':winner(s),'tie':len(winner(s))>1,'raw':str(raw),'input_ids_sha256':prompt_hash,
+            'description_positions':positions,'token_count':p['attention'].shape[1]}
+
+
+if __name__ == '__main__':
+    main()
