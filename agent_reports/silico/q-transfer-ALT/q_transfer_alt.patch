+class AnalysisTests(unittest.TestCase):
+    def setUp(self):
+        # Deliberately reduced synthetic arrays isolate the raw-data validator.
+        # Production's full-panel boundary is independently tested below and in test_panel.
+        seam = patch.object(analysis, 'validate_panel', return_value={'synthetic_fixture': True})
+        seam.start()
+        self.addCleanup(seam.stop)
