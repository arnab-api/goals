+++ b/src/q_transfer_alt/panel.py
@@ -0,0 +1,153 @@
+"""Regenerate the original matched grid from the shipped bank and closed fixtures.
+
+The immutable historical panel is a comparison artifact, never a builder input.
+Random draw order, family-pool ordering, and the opaque-name RNG namespace are
+intentionally retained from the original builder.
+"""
+from collections import defaultdict
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import random
+
+from . import CONFIG_DIR
+from .bank.builder import implementation_hash
+from .bank.registry import Registry
+from .bank.render import opaque_names, render_prompt, RENDERER_VERSION
+from .bank.sampling import validate_roles
+from .bank.scenarios import Layout, Scenario
+from .bank.task import BANK_VERSION, DOMAINS, digest
+from .validate_panel import OLD16_SIGNATURES, PREDICTIONS, validate_panel
+
+ROLES = tuple("abcdefxyz")
+CRITICAL_ROLES = tuple("bcdef")
+SCENARIOS = {
+    "ALT1": Scenario("ALT1_KV_GRID_V1", Layout(tuple("abcd"), tuple("abd")),
+                     Layout(tuple("axyz"), tuple("a")), Layout(tuple("abde"), tuple("a"))),
+    "ALT2": Scenario("ALT2_KV_GRID_V1", Layout(tuple("abcd"), tuple("abd")),
+                     Layout(tuple("axyz"), tuple("a")), Layout(tuple("adef"), tuple("a"))),
+    "ALT3": Scenario("ALT3_KV_GRID_V1", Layout(tuple("abcd"), tuple("abc")),
+                     Layout(tuple("axyz"), tuple("a")), Layout(tuple("acbe"), tuple("a"))),
+}
+
+
+def _source_hash():
+    """Hash this package's relevant source, never the historical implementation."""
+    here = Path(__file__).parent
+    paths = [here / name for name in ("__init__.py", "panel.py", "loader.py",
+                                      "prompts.py", "validate_panel.py")]
+    paths += sorted((here / "bank").glob("*.py"))
+    return digest({p.relative_to(here).as_posix(): p.read_text(encoding="utf-8")
+                   for p in paths})
+
+
+def build_panel(preset="original-grid"):
+    """Return a fresh, fully validated 384-row panel using standard library only.
+
+    Scientific content reproduces the original grid. Implementation and content
+    hashes describe this package, so regenerated bytes are not historical bytes.
+    The only supported preset fixes the original seed ranges and 32 groups/type.
+    """
+    if preset != "original-grid":
+        raise ValueError(f"Unknown preset: {preset}")
+    preset_bytes = (CONFIG_DIR / "original_grid.json").read_bytes()
+    config = json.loads(preset_bytes)
+    seed_bases = {"int": 31000, "str": 41000, "list[int]": 51000, "list[str]": 61000}
+    if (config["preset"] != preset or config["datatype_seed_bases"] != seed_bases
+            or config["groups_per_datatype"] != 32):
+        raise ValueError("Original-grid seed/count fixture has changed")
+    head_bytes = (CONFIG_DIR / "goal250.json").read_bytes()
+    heads = json.loads(head_bytes)
+    reg = Registry()
+    definitions = {t.id: t.record() for t in reg.tasks}
+    exclusions = set(OLD16_SIGNATURES)
+    rows, groups = [], []
+    for datatype, base in seed_bases.items():
+        pool = sorted((t for t in reg.tasks if t.datatype == datatype), key=lambda t: t.id)
+        families = defaultdict(list)
+        for task in pool:
+            families[task.family].append(task)
+        family_names = sorted(families)
+        for index in range(32):
+            seed = base + index
+            rng = random.Random(seed)
+            if datatype.startswith("list"):
+                chosen_families = rng.sample(family_names, 9)
+                selected = [rng.choice(families[f]) for f in chosen_families]
+                mapping = {role: task.id for role, task in zip(ROLES, selected)}
+                policy = "all_nine_roles_distinct_families"
+            else:
+                chosen_families = rng.sample(family_names, len(CRITICAL_ROLES))
+                selected = [rng.choice(families[f]) for f in chosen_families]
+                mapping = {role: task.id for role, task in zip(CRITICAL_ROLES, selected)}
+                used = set(mapping.values())
+                support = rng.sample([task for task in pool if task.id not in used], 4)
+                mapping.update({role: task.id for role, task in zip("axyz", support)})
+                mapping = {role: mapping[role] for role in ROLES}
+                policy = "bcdef_distinct_families_supporting_axyz_may_overlap"
+            alt1_roles = {r: mapping[r] for r in SCENARIOS["ALT1"].roles}
+            if (datatype, digest(alt1_roles)) in exclusions:
+                raise ValueError("Prior smoke ALT1 assignment reused; never silently resample")
+            names = opaque_names(ROLES, seed)
+            group_id = f"{datatype}-group-{index:02d}"
+            groups.append(dict(
+                id=group_id, datatype=datatype, index=index, seed=seed, roles=mapping,
+                opaque_names=names, family_policy=policy,
+                family_by_role={r: reg.get(t).family for r, t in mapping.items()},
+                task_definition_sha256={r: definitions[t]["definition_sha256"]
+                                        for r, t in mapping.items()},
+            ))
+            for alt, scenario in SCENARIOS.items():
+                if scenario.predictions != PREDICTIONS[alt]:
+                    raise ValueError(f"Symbolic predictions changed: {alt}")
+                subset = {r: mapping[r] for r in scenario.roles}
+                validate_roles(reg, subset, scenario.roles, datatype,
+                               "distinct" if datatype.startswith("list") else "any")
+                row_names = {r: names[r] for r in (*scenario.roles, "pending")}
+                prompts = {key: render_prompt(reg, subset, row_names, datatype, layout)
+                           for key, layout in (("p_src", scenario.src), ("p_kv", scenario.kv),
+                                               ("p_dst", scenario.dst))}
+                rows.append(dict(id=f"{alt}/{group_id}", group_id=group_id, scenario=alt,
+                                 datatype=datatype, seed=seed, roles=subset, opaque_names=row_names,
+                                 prompts=prompts, predictions=scenario.predictions))
+    output = dict(
+        schema="alternate_hypothesis_kv_gaze_grid_v1", bank_version=BANK_VERSION,
+        bank_sha256=reg.sha256, bank_implementation_sha256=implementation_hash(),
+        renderer_version=RENDERER_VERSION, task_definitions=definitions, input_domains=DOMAINS,
+        scenarios={key: scenario.record() for key, scenario in SCENARIOS.items()},
+        groups=groups, rows=rows, goal_heads=heads,
+        goal_heads_sha256=hashlib.sha256(head_bytes).hexdigest(),
+        settings=config["settings"], design_notes=config["design_notes"],
+        generation_provenance={
+            "implementation": "q_transfer_alt.panel.build_panel", "preset": preset,
+            "package_source_sha256": _source_hash(),
+            "preset_file_sha256": hashlib.sha256(preset_bytes).hexdigest(),
+            "smoke_exclusions_file_sha256": hashlib.sha256(
+                (CONFIG_DIR / "smoke_exclusions.json").read_bytes()).hexdigest(),
+            "historical_panel_read": False,
+        },
+    )
+    output["content_sha256"] = digest(output)
+    validate_panel(output)
+    return output
+
+
+def main(argv=None):
+    """Write regenerated JSON; --output is required and cannot replace the original."""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", required=True, type=Path)
+    parser.add_argument("--preset", choices=("original-grid",), default="original-grid")
+    args = parser.parse_args(argv)
+    if args.output.resolve() == (CONFIG_DIR / "panel.original.json").resolve():
+        parser.error("The historical panel is immutable; choose a different --output")
+    panel = build_panel(args.preset)
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(panel, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({"output": str(args.output), "rows": len(panel["rows"]),
+                      "groups": len(panel["groups"]), "content_sha256": panel["content_sha256"]}))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
