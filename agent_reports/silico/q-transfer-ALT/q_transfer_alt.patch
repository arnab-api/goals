+
+    def test_pairwise_typed_functional_signatures(self):
+        # This finite-suite distinction is evidence, not a proof of independence.
+        for datatype, cases in CASES.items():
+            signatures = {}
+            tasks = [task for task in TASKS if task.datatype == datatype]
+            for task in tasks:
+                signatures[task.id] = tuple(canonical(typed(task.evaluate(case))) for case in cases)
+            for left, right in itertools.combinations(tasks, 2):
+                with self.subTest(left=left.id, right=right.id):
+                    self.assertNotEqual(signatures[left.id], signatures[right.id])
+        self.assertNotEqual(typed(True), typed(1))
+        self.assertNotEqual(typed(False), typed(0))
+
+    def test_preferred_semantic_examples(self):
+        examples = {
+            'all_nonempty': [([], True), (['', 'a'], False), ([' ', 'é'], True)],
+            'lexical_min': [([], ''), (['z', 'A', 'a'], 'A'), (['a', ''], '')],
