+        dst=mats[0]['prompts']['p_dst']; assert all(m['prompts']['p_dst']['input_ids']==dst['input_ids'] for m in mats)
+        assert all(m['destination_positions']==mats[0]['destination_positions'] for m in mats), 'Shared self-control requires identical recipient span'
+        dsthash=sha(dst['input_ids']);source_cache={};check={'group_id':gid,'sources':{},'rows':{},'cache_reuse':[]}
