+            'uppercase_chars': [([], 0), (['AÉΣ', 'ß', 'İ', 'ǅ', '中', '²'], 4)],
+            'distinct_chars': [([], 0), (['ab', 'ba', '', 'a'], 2), (['é', 'e\u0301'], 3)],
