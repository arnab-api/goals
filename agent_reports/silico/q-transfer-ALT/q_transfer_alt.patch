+"""Bounded list tasks with loop-based independent references.
+
+Families are curation-policy labels, not claims of mathematical independence.
+Variants intentionally share families. Expressions are single assignment RHSs;
+inputs follow the list domains declared in task.py. Unicode predicates use
+Python's code-point semantics (no normalization or case folding).
+"""
+from .task import Task
+
+
+def int_length(x):
+    count = 0
+    for _ in x:
+        count += 1
+    return count
+
+
+def int_sum(x):
+    total = 0
+    for value in x:
+        total += value
+    return total
+
+
+def int_abs_sum(x):
+    total = 0
+    for value in x:
+        total += -value if value < 0 else value
+    return total
+
+
+def int_sum_squares(x):
+    total = 0
+    for value in x:
+        total += value * value
+    return total
+
+
+def int_minimum(x):
+    if not x:
+        return 0
+    result = x[0]
+    for value in x:
+        if value < result:
+            result = value
+    return result
+
+
+def int_maximum(x):
+    if not x:
+        return 0
+    result = x[0]
+    for value in x:
+        if value > result:
+            result = value
+    return result
+
+
+def int_range(x):
+    if not x:
+        return 0
+    low = high = x[0]
+    for value in x:
+        if value < low:
+            low = value
+        if value > high:
+            high = value
+    return high - low
+
+
+def int_first(x):
+    for value in x:
+        return value
+    return 0
+
+
+def int_last(x):
+    result = 0
+    for value in x:
+        result = value
+    return result
+
+
+def int_count_odd(x):
+    count = 0
+    for value in x:
+        if value % 2 != 0:
+            count += 1
+    return count
+
+
+def int_count_positive(x):
+    count = 0
+    for value in x:
+        if value > 0:
+            count += 1
+    return count
+
+
+def int_count_negative(x):
+    count = 0
+    for value in x:
+        if value < 0:
+            count += 1
+    return count
+
+
+def int_count_zero(x):
+    count = 0
+    for value in x:
+        if value == 0:
+            count += 1
+    return count
+
+
+def int_count_even(x):
+    count = 0
+    for value in x:
+        if value % 2 == 0:
+            count += 1
+    return count
+
+
+def int_distinct_count(x):
+    seen = []
+    for value in x:
+        if value not in seen:
+            seen.append(value)
+    return len(seen)
+
+
+def int_duplicate_count(x):
+    seen = set()
+    count = 0
+    for value in x:
+        if value in seen:
+            count += 1
+        else:
+            seen.add(value)
+    return count
+
+
+def int_all_positive(x):
+    for value in x:
+        if value <= 0:
+            return False
+    return True
+
+
+def int_any_negative(x):
+    for value in x:
+        if value < 0:
+            return True
+    return False
+
+
+def int_nondecreasing(x):
+    for index in range(1, len(x)):
+        if x[index] < x[index - 1]:
+            return False
+    return True
+
+
+def int_palindrome(x):
+    left, right = 0, len(x) - 1
+    while left < right:
+        if x[left] != x[right]:
+            return False
+        left += 1
+        right -= 1
+    return True
+
+
+def int_equal_adjacent(x):
+    count = 0
+    previous = None
+    for value in x:
+        if value == previous:
+            count += 1
+        previous = value
+    return count
+
+
+def int_sign_changes(x):
+    count = 0
+    for index in range(1, len(x)):
+        before, after = x[index - 1], x[index]
+        if (before < 0 and after > 0) or (before > 0 and after < 0):
+            count += 1
+    return count
+
+
+def int_reverse(x):
+    result = []
+    for value in x:
+        result.insert(0, value)
+    return result
+
+
+def int_sorted(x):
+    result = []
+    for value in x:
+        index = 0
+        while index < len(result) and result[index] <= value:
+            index += 1
+        result.insert(index, value)
+    return result
+
+
+def int_sorted_desc(x):
+    result = []
+    for value in x:
+        index = 0
+        while index < len(result) and result[index] >= value:
+            index += 1
+        result.insert(index, value)
+    return result
+
+
+def int_unique_sorted(x):
+    result = []
+    for value in x:
+        if value in result:
+            continue
+        index = 0
+        while index < len(result) and result[index] < value:
+            index += 1
+        result.insert(index, value)
+    return result
+
+
+def int_positive_values(x):
+    result = []
+    for value in x:
