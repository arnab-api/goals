+"""Focused stdlib-only checks: python -m unittest discover
+-s test/q_transfer_alt -p test_bank_lists.py -v
+"""
+import _q_transfer_alt_testpath  # supports stdlib unittest discovery from repository root
+import ast
+from collections import Counter
+from copy import deepcopy
+import inspect
+import itertools
+import random
+import unittest
+
+import sys
+from pathlib import Path
+
+from q_transfer_alt.bank.bank_lists import TASKS
+from q_transfer_alt.bank.task import canonical, in_domain, output_matches, typed
+
+
+def bounded_cases():
+    rng = random.Random(20260217)
+    integers = [
+        [], [0], [1], [-1], [2], [-2], [1000000], [-1000000],
+        [0, 0], [1, -1], [-1, 0, 1], [2, 1, 2], [3, -2, 0, 3, -1],
+        [1, 2, 3, 4], [4, 3, 2, 1], [5] * 32, [0] * 32,
+        [-1000000, 1000000] * 16, list(range(-16, 16)),
+    ]
+    words = [
+        [], [''], ['a'], ['A'], ['ab'], ['', ''], ['a', 'a'],
+        ['b', 'a', 'b'], ['ab', 'ba', 'ab', 'AB', ''],
+        ['z', 'aa', 'bb', 'a'], ['aa', 'z', 'b', 'cc'],
+        ['', 'Ab', '', 'é', ''], ['é', 'e\u0301', 'É', '中', '🙂'],
+        ['ß', 'İ', 'Σ', 'ΟΣ', 'ǅ', '²', '٣', '\u00a0', '\t'],
+        ['A² ', 'éÉ', '🙂🙂'], ['a'] * 32, [''] * 32,
+        ['🙂' * 32] * 32, ['x' * 32, 'y', 'x' * 32],
+        ['\0', '\n', ' ', '\ud800', '\U0010ffff'],
+    ]
+    for length in range(4):
+        integers.extend(list(v) for v in itertools.product([-2, 0, 1], repeat=length))
+        words.extend(list(v) for v in itertools.product(['', 'a', 'B', 'ab'], repeat=length))
+    int_pool = [-1000000, -99, -2, -1, 0, 1, 2, 3, 37, 1000000]
+    word_pool = ['', 'a', 'bb', 'ab', 'ba', 'Ab', 'A', 'é', 'É', 'e\u0301',
+                 '🙂', '中', 'ß', 'İ', 'ΟΣ', '²', '٣', ' a\t', '\n', 'z' * 32]
+    alphabet = 'aBéÉßİΣ中🙂 ²٣\t\u0301'
+    for _ in range(160):
+        length = rng.randrange(33)
+        integers.append([rng.choice(int_pool) for _ in range(length)])
+        words.append([rng.choice(word_pool) for _ in range(length)])
+    for _ in range(40):
+        length = rng.randrange(33)
+        integers.append([rng.randint(-1000000, 1000000) for _ in range(length)])
+        words.append([''.join(rng.choice(alphabet) for _ in range(rng.randrange(33)))
+                      for _ in range(length)])
+    return {'list[int]': integers, 'list[str]': words}
+
+
+CASES = bounded_cases()
+BY_ID = {task.id: task for task in TASKS}
+PREFERRED = {
+    'all_nonempty': 'quantification',
+    'lexical_min': 'lexical_extrema',
+    'anagram_groups': 'anagram_classes',
+    'total_chars': 'length_aggregation',
+    'initials': 'positional_transform',
+    'equal_adjacent': 'adjacency',
+    'uppercase_chars': 'character_classification',
+    'distinct_chars': 'character_diversity',
+    'palindrome': 'symmetry',
+}
+
+
+class ListBankTests(unittest.TestCase):
+    def test_metadata_and_single_rhs_contract(self):
+        self.assertEqual(Counter(task.datatype for task in TASKS),
+                         {'list[int]': 32, 'list[str]': 32})
+        self.assertEqual(len(BY_ID), 64)
+        self.assertEqual(len({task.reference.__name__ for task in TASKS}), 64)
+        allowed_calls = {'len', 'sum', 'abs', 'min', 'max', 'set', 'all', 'any',
+                         'sorted', 'range', 'zip', 'tuple', 'map', 'bool'}
+        for task in TASKS:
+            with self.subTest(task=task.id):
+                prefix = 'list_int' if task.datatype == 'list[int]' else 'list_str'
+                self.assertRegex(task.id, rf'^py\.{prefix}\.[a-z_]+\.v1$')
+                self.assertTrue(task.description)
+                self.assertTrue(task.family)
+                self.assertNotIn('\n', task.expression)
+                self.assertNotIn(';', task.expression)
+                tree = ast.parse('result = ' + task.expression)
+                self.assertEqual(len(tree.body), 1)
+                self.assertIsInstance(tree.body[0], ast.Assign)
+                self.assertFalse(any(isinstance(node, (ast.Lambda, ast.NamedExpr,
+                                                       ast.Import, ast.ImportFrom))
+                                     for node in ast.walk(tree)))
+                for node in ast.walk(tree):
+                    if isinstance(node, ast.Call) and isinstance(node.func, ast.Name):
+                        self.assertIn(node.func.id, allowed_calls)
+                reference_tree = ast.parse(inspect.getsource(task.reference))
+                self.assertIsInstance(reference_tree.body[0], ast.FunctionDef)
+                self.assertTrue(any(isinstance(node, (ast.For, ast.While))
+                                    for node in ast.walk(reference_tree)))
+                self.assertFalse(any(isinstance(node, ast.Call)
+                                     and isinstance(node.func, ast.Name)
+                                     and node.func.id == task.reference.__name__
+                                     for node in ast.walk(reference_tree)))
+                # Export metadata remains usable by the parent registry/renderer.
+                self.assertEqual(task.record()['assignment'], '{name} = ' + task.expression)
