+def condition(scores, raw='raw.npz', positions=None, ids=None):
+    positions = positions or {r: [i] for i, r in enumerate(scores)}
+    winners = [r for r, s in scores.items() if s == max(scores.values())]
+    return {'scores': scores, 'sums': {r: s * len(positions[r]) for r, s in scores.items()},
+            'description_token_counts': {r: len(p) for r, p in positions.items()},
+            'description_positions': positions, 'winners': winners, 'tie': len(winners) > 1,
+            'raw': raw, 'input_ids_sha256': analysis.digest(ids or [10, 11, 12, 13]),
+            'token_count': len(ids or [10, 11, 12, 13])}
+
+
+def small_records():
+    records = []
+    for datatype in ('int', 'str'):
+        for group in range(3):
+            for scenario, roles in [('ALT1', 'abde'), ('ALT2', 'adef'), ('ALT3', 'acbe')]:
+                before = {r: float(np.float32((group + 1) / 16)) for r in roles}
+                before['e'] += .5
+                after = dict(before)
+                after['e'] += (group + 1) / 8
+                if group == 0 and scenario == 'ALT1':
+                    after['d'] = after['e']  # preserve an exact tie
+                cs = {name: condition(scores) for name, scores in zip(analysis.PRIMARY, (before, after))}
+                for c in cs.values():
+                    c['set_minus_alternative'] = c['scores']['e'] - c['scores'][analysis.ALTERNATIVE[scenario]]
+                cs.update(clean_source=condition(dict(zip('abcd', [.25] * 4))),
+                          clean_destination=condition(dict(zip('axyz', [.25] * 4))))
+                gid = f'{datatype}-{group}'
+                records.append({'id': scenario + '/' + gid, 'group_id': gid, 'datatype': datatype,
+                                'scenario': scenario, 'seed': group, 'config_sha256': 'config', 'panel_sha256': 'panel',
+                                'roles': {r: 'task.' + r for r in 'abcdefxyz'}, 'predictions': {},
+                                'prompt_hashes': {p: p + '-hash' for p in ('p_src', 'p_kv', 'p_dst')},
+                                'materialized': 'map.json', 'source_cache_key': 'cache', 'conditions': cs,
+                                'paired_margin_change': cs[analysis.PRIMARY[1]]['set_minus_alternative'] -
+                                                        cs[analysis.PRIMARY[0]]['set_minus_alternative']})
+    return records
+
+
+def refresh_manifest(sub):
+    complete = analysis.load(sub / 'complete.json')
+    complete['file_sha256'] = {p.name: hashlib.sha256(p.read_bytes()).hexdigest()
+                               for p in sub.iterdir() if p.is_file() and p.name != 'complete.json'}
+    analysis.dump(sub / 'complete.json', complete)
+
+
+def make_pilot_grid(tmp_path, historical=False):
+    """Four one-group datatypes with tiny causal rows and real artifact contracts."""
+    from q_transfer_alt.provenance import source_cache_key
+
+    root, grid = tmp_path / 'project', tmp_path / 'grid'
+    (root / 'configs').mkdir(parents=True)
+    grid.mkdir()
+    panel = {'groups': [], 'rows': [], 'goal_heads': [[0, 0], [1, 1]]}
+    for datatype in ('int', 'str', 'list[int]', 'list[str]'):
+        gid = datatype + '-group-00'
+        panel['groups'].append({'id': gid, 'datatype': datatype, 'index': 0})
+        for scenario, kv_roles in [('ALT1', 'abde'), ('ALT2', 'adef'), ('ALT3', 'acbe')]:
+            panel['rows'].append({'id': scenario + '/' + gid, 'group_id': gid, 'datatype': datatype,
+                                  'scenario': scenario, 'seed': 0, 'roles': {r: 'task.' + r for r in 'abcdefxyz'},
+                                  'predictions': {}, 'prompts': {k: {'listed_roles': list(rs)} for k, rs in
+                                  [('p_src', 'abcd'), ('p_kv', kv_roles), ('p_dst', 'axyz')]}})
+    analysis.dump(root / 'configs/panel.json', panel)
+    panel_sha = hashlib.sha256((root / 'configs/panel.json').read_bytes()).hexdigest()
+    analysis.dump(grid / 'environment.json', {'panel_sha256': panel_sha, 'revision': 'synthetic', 'pilot': True, 'schema': 'q_transfer_alt_run_v1', 'recipe_sha256': 'a' * 64})
+    all_records = []
+    for group in panel['groups']:
+        gid = group['id']
+        sub = grid / 'groups' / gid
+        sub.mkdir(parents=True)
+        rows = [r for r in panel['rows'] if r['group_id'] == gid]
+        materials, records = [], []
+        for row in rows:
+            scenario = row['scenario']
+            prompts = {}
+            for key, info in row['prompts'].items():
+                ids = ([20, 21, 22, 23] if key == 'p_src' and scenario == 'ALT3' else [10, 11, 12, 13])
+                prompts[key] = {'input_ids': ids, 'input_ids_sha256': analysis.digest(ids),
+                                'attention_mask': [1] * 4, 'offset_mapping': [[i, i + 1] for i in range(4)],
+                                'final_equals_index': 3, 'task_positions': list(range(4)),
+                                'description_positions': {r: [i] for i, r in enumerate(info['listed_roles'])}}
+            materials.append({'id': row['id'], 'row_config_sha256': analysis.digest(row), 'prompts': prompts,
+                              'alignment_width': 4, 'donor_positions': list(range(4)), 'destination_positions': list(range(4)),
+                              'donor_to_dst': [[i, i] for i in range(4)],
+                              'condition_prompt_keys': {k: 'p_dst' for k in ('clean_destination',) + analysis.PRIMARY}})
+            cs = {}
+            for name in analysis.PRIMARY + analysis.DIAGNOSTICS:
+                prompt = prompts['p_src' if name == 'clean_source' else 'p_dst']
+                positions = prompts['p_kv']['description_positions'] if name in analysis.PRIMARY else prompt['description_positions']
+                filename = (('ALT1' if scenario == 'ALT2' else scenario) + '_source.npz' if name == 'clean_source'
+                            else 'clean_destination.npz' if name == 'clean_destination' else scenario + '_' + name + '.npz')
+                np.savez(sub / filename, head_ids=np.array(panel['goal_heads']),
+                         attention=np.full((2, 4), .25, dtype=np.float32), value_norm=np.ones((2, 4), dtype=np.float32),
+                         head_output=np.zeros((2, 2), dtype=np.float32))
+                cs[name] = condition({r: .25 for r in positions}, f'groups/{gid}/{filename}', positions, prompt['input_ids'])
+                if name in analysis.PRIMARY:
+                    cs[name]['set_minus_alternative'] = 0.
+            records.append({k: row[k] for k in ('id', 'group_id', 'scenario', 'datatype', 'seed', 'roles', 'predictions')})
+            records[-1].update(config_sha256=analysis.digest(row), panel_sha256=panel_sha, conditions=cs,
+                               prompt_hashes={k: analysis.digest(p['input_ids']) for k, p in prompts.items()},
+                               materialized=f'groups/{gid}/materialized.json', paired_margin_change=0.,
+                               recipe_sha256='a' * 64,
+                               source_cache_key=(analysis.digest({'ids': prompts['p_src']['input_ids'], 'heads': panel['goal_heads'],
+                                                                 'revision': 'synthetic', 'patch': None}) if historical else
+                                                 source_cache_key(prompts['p_src']['input_ids'], panel['goal_heads'], 'a' * 64)))
+            if historical:
+                records[-1].pop('recipe_sha256')
+        analysis.dump(sub / 'scores.json', records)
+        analysis.dump(sub / 'materialized.json', materials)
+        analysis.dump(sub / 'complete.json', {'schema': 'q_transfer_alt_group_v1', 'group_id': gid, 'records': 3, 'group_sha256': analysis.digest(group), 'panel_sha256': panel_sha, 'recipe_sha256': 'a' * 64})
+        analysis.dump(sub / 'checks.json', {'group_id': gid, 'cache_reuse': [{'scenario': 'ALT2', 'source_key': records[1]['source_cache_key'],
+                                                                          'same_exact_ids': True}]})
+        if historical:
+            complete = analysis.load(sub / 'complete.json')
+            complete.pop('schema')
+            analysis.dump(sub / 'complete.json', complete)
+        refresh_manifest(sub)
+        all_records.extend(records)
+    analysis.dump(grid / 'scores.json', all_records)
+    return grid, root / 'configs/panel.json'
