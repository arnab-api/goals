+    print('STARTUP', json.dumps(env), flush=True)
+    model = AutoModelForCausalLM.from_pretrained(mp, local_files_only=True, trust_remote_code=False,
+        dtype=torch.bfloat16, attn_implementation='eager').to('cuda').eval()
+    assert model.dtype == torch.bfloat16 and len(model.model.layers) == 64
+    assert model.config.num_attention_heads == 40 and model.config.num_key_value_heads == 8
+    assert not getattr(model.config, 'quantization_config', None)
+    assert all(p.device.type == 'cuda' for p in model.parameters())
