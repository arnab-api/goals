+"""Scalar tasks over the bounded domains in task.py.
+
+Family policy: families group a shared computational primitive, not purportedly
+independent problems. All decimal representations/aggregations share one family;
+all binary operations share one family; division/rounding variants share one;
+and square-root variants share one. String case maps, boundary trimming,
+positional selections and whitespace tokenization group their variants.
+Character predicates and counts share a classification family; sorting and
+deduplication share an ordering/deduplication family. Distinct IDs
+and finite-suite signatures do not establish computational independence.
+"""
+from .task import Task
+
+
+def int_absolute(x):
+    if x < 0:
+        return -x
+    return x
+
+
+def int_square(x):
+    return pow(x, 2)
+
+
+def int_negate(x):
+    return 0 - x
+
+
+def int_sign(x):
+    if x < 0:
+        return -1
+    if x > 0:
+        return 1
+    return 0
+
+
+def int_even(x):
+    return (x & 1) == 0
+
+
+def int_floor_half(x):
+    quotient, remainder = divmod(x, 2)
+    return quotient
+
+
+def int_ceil_half(x):
+    quotient, remainder = divmod(x, 2)
+    if remainder:
+        quotient += 1
+    return quotient
+
+
+def int_modulo_ten(x):
+    quotient = x // 10
+    return x - quotient * 10
+
+
+def int_floor_ten(x):
+    return x - x % 10
+
+
+def int_triangular(x):
+    n = -x if x < 0 else x
+    # Divide an even factor first, rather than multiplying then dividing.
+    if n % 2:
+        return n * ((n + 1) // 2)
+    return (n // 2) * (n + 1)
+
+
+def int_digit_count(x):
+    n = -x if x < 0 else x
+    count = 1
+    while n >= 10:
+        n //= 10
+        count += 1
+    return count
+
+
+def int_digit_sum(x):
+    n = -x if x < 0 else x
+    total = 0
+    while n:
+        n, digit = divmod(n, 10)
+        total += digit
+    return total
+
+
+def int_digit_max(x):
+    n = -x if x < 0 else x
+    maximum = 0
+    while n:
+        n, digit = divmod(n, 10)
+        if digit > maximum:
+            maximum = digit
+    return maximum
+
+
+def int_reverse_digits(x):
+    n = -x if x < 0 else x
+    result = 0
+    while n:
+        n, digit = divmod(n, 10)
+        result = result * 10 + digit
+    return result
+
+
+def int_digits(x):
+    n = -x if x < 0 else x
+    result = []
+    while True:
+        n, digit = divmod(n, 10)
+        result.insert(0, digit)
+        if n == 0:
+            return result
+
+
+def int_zero_digits(x):
+    n = -x if x < 0 else x
+    count = 0
+    while True:
+        n, digit = divmod(n, 10)
+        if digit == 0:
+            count += 1
+        if n == 0:
+            return count
+
+
+def int_unique_digits(x):
+    n = -x if x < 0 else x
+    seen = [False] * 10
+    while True:
+        n, digit = divmod(n, 10)
+        seen[digit] = True
+        if not n:
+            break
+    count = 0
+    for present in seen:
+        if present:
+            count += 1
+    return count
+
+
+def int_digit_palindrome(x):
+    n = -x if x < 0 else x
+    original = n
+    reverse = 0
+    while n:
+        n, digit = divmod(n, 10)
+        reverse = reverse * 10 + digit
+    return original == reverse
+
+
+def int_bit_length(x):
+    n = -x if x < 0 else x
+    count = 0
+    while n:
+        n //= 2
+        count += 1
+    return count
+
+
+def int_popcount(x):
+    n = -x if x < 0 else x
+    count = 0
+    while n:
+        n, bit = divmod(n, 2)
+        count += bit
+    return count
+
+
+def int_power_two(x):
+    if x <= 0:
+        return False
+    n = x
+    while n % 2 == 0:
+        n //= 2
+    return n == 1
+
+
+def int_lowest_bit(x):
+    n = -x if x < 0 else x
+    if n == 0:
+        return 0
+    result = 1
+    while n % 2 == 0:
+        result *= 2
+        n //= 2
+    return result
+
+
+def int_clear_lowest_bit(x):
+    n = -x if x < 0 else x
+    if n == 0:
+        return 0
+    divisor = 1
+    while (n // divisor) % 2 == 0:
+        divisor *= 2
+    return n - divisor
+
+
+def int_binary(x):
+    n = -x if x < 0 else x
+    result = ''
