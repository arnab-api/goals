+
+PREFERRED = dict(zip("abcdefxyz", ["py.list_str." + s + ".v1" for s in
+    ("all_nonempty", "lexical_min", "anagram_groups", "total_chars", "initials", "equal_adjacent", "uppercase_chars", "distinct_chars", "palindrome")]))
+EXAMPLE_INPUT = ["Tea", "eat", "ate", "", "ABC", "ABC", "x", ""]
+BASE_REVISION = "7ef5101a7a1e28acbc70f0c4f8bf2d73aca6fde7"
