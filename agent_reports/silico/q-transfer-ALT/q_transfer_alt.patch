+    def test_cell_pair_and_triplet_summaries_link_all_scenarios(self):
+        records = small_records()
+        summary, cells, paired, triplets = analysis.summarize(records, draws=200)
+        assert len(cells) == 3 * 3 * 2 * 4  # two datatypes plus stratified pool
+        assert len(paired) == 9 and len(triplets) == 6
+        a2, a3 = [next(r for r in paired if r['datatype'] == 'int' and r['scenario'] == s)
+                  for s in ('ALT2', 'ALT3')]
+        assert a2['margin_change_ci_low'] == a3['margin_change_ci_low']
+        assert a2['margin_change_ci_high'] == a3['margin_change_ci_high']
+        assert a2['margin_change_value'] == .25
+        assert summary['bootstrap']['groups_per_datatype'] == {'int': 3, 'str': 3}
